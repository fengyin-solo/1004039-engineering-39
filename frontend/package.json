{
  "name": "underground-pipeline-inspection-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "repoKind": "frontend-only",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/contractor-pipeline.mjs all",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "contractor:prepare": "node scripts/contractor-pipeline.mjs prepare",
    "contractor:validate": "node scripts/contractor-pipeline.mjs validate",
    "contractor:pipeline": "node scripts/contractor-pipeline.mjs all",
    "test": "node --test test/"
  },
  "dependencies": {
    "pinia": "^2.1.7",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@vitejs/plugin-vue": "^5.0.4",
    "typescript": "^5.4.3",
    "vite": "^5.2.6",
    "vue-tsc": "^2.0.7"
  }
}
